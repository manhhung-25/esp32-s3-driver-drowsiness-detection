# ===== Driver Drowsiness Detection - Default Config =====

# ---- Flash: N16 = 16MB, QIO 80MHz ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# ---- Custom partition table ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Console via UART0 (stable monitor on the USB-UART COM port) ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ---- Disable stub for fast flash ----
CONFIG_ESPTOOLPY_NO_STUB=y

# ---- Camera 240x240 ----
CONFIG_DROWSY_FRAME_SIZE_240X240=y

# ---- Connected OV2640: big-endian RGB565 ----
CONFIG_DROWSY_CAM_RGB565_BE=y
CONFIG_DROWSY_AI_SAMPLE_EVERY_N=2
CONFIG_DROWSY_DISTRACT_YAW_TH=220
CONFIG_DROWSY_FACE_LOST_MS=800
CONFIG_DROWSY_DISTRACT_MS=2000
CONFIG_DROWSY_WEB_JPEG_QUALITY=35
CONFIG_DROWSY_WEB_STREAM_SKIP=1

# ---- Embedded model RODATA to PSRAM ----
CONFIG_SPIRAM_RODATA=y

# ---- Web monitor ----
CONFIG_DROWSY_WEB_ENABLE=y
CONFIG_DROWSY_WEB_HTTP_PORT=80
CONFIG_DROWSY_WEB_STREAM_PORT=81
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_DROWSY_WIFI_MODE_AP=y
CONFIG_DROWSY_AI_ON_DEVICE=y
